class Solution {
    public String removeOuterParentheses(String s) {
        StringBuilder sb = new StringBuilder();
        int c=0;

        for(char i : s.toCharArray()){
            if(i == ')') c--;
            if(c != 0) sb.append(i);
            if(i == '(') c++;
        }

        return sb.toString();
    }
}
