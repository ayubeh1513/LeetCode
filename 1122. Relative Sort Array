class Solution {
    public int[] relativeSortArray(int[] arr1, int[] arr2) {
        int[] a = new int[1001];
        ArrayList<Integer> ar = new ArrayList<>();

        for(int i : arr1){
            a[i] = a[i] + 1;
        }

        for(int i : arr2){
            int d = a[i];
            while(d > 0){
                ar.add(i);
                d--;
            }
            a[i] = 0; 
        }

        for(int i = 0; i < a.length; i++){
            while(a[i] > 0){
                ar.add(i);
                a[i]--;
            }
        }

        for(int i = 0; i < arr1.length; i++){
            arr1[i] = ar.get(i);
        }

        return arr1;
    }
}
