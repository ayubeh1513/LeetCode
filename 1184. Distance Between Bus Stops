class Solution {
    public int distanceBetweenBusStops(int[] d, int s, int t) {
        if (s > t) {
            int x = s;
            s = t;
            t = x;
        }

        int a = 0, b = 0;

        for (int i = 0; i < d.length; i++) {
            a += d[i];
            if (i >= s && i < t) {
                b += d[i];
            }
        }

        return Math.min(b, a - b);
    }
}
