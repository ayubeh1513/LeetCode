class Solution {
    public int[] sumZero(int n) {
        int[] a = new int[n];
        int b = 0;
        if(n%2 != 0) {
            a[b]=0;
            b++;
            int c = 1;
            for(int i=0; i<(n-1)/2; i++){
                a[b] = c;
                b++;
                a[b] = c*-1;
                b++;
                c++;
            }
        } else {
            int d = 1;
            for(int i=0; i<n/2; i++){
                a[b] = d;
                b++;
                a[b] = d*-1;
                b++;
                d++;
            }
        }

        return a;
    }
}
