class Solution {
    public int singleNumber(int[] nums) {
        Map<Integer, Integer> m = new HashMap<>();
        for(int i : nums){
            if(m.containsKey(i)){
                m.put(i, m.get(i) + 1);
            } else {
                m.put(i, 1);
            }
        }

        for(int i : m.keySet()){
            if(m.get(i) == 1) return i;
        }

        return -1;
    }
}
