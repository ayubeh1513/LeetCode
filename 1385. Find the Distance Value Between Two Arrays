class Solution {
    public int findTheDistanceValue(int[] arr1, int[] arr2, int d) {
        int a=0;
        for(int i : arr1){
            int n=0;
            for(int j : arr2){
                if(Math.abs(i-j)<=d) n=1;
            }
            if(n==0) a++;
        }
        return a;
    }
}
