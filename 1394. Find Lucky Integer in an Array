class Solution {
    public int findLucky(int[] arr1) {
        int a = -1;
        int[] arr = new int[501];
        for(int i : arr1){
            arr[i]++;
        }
        for(int i=0; i<arr.length; i++){
            if(arr[i]==i) a = Math.max(a, i);
        }
        if(a==0) return -1;
        return a;
    }
}
