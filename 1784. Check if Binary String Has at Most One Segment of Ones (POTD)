class Solution {
    public boolean checkOnesSegment(String s) {
        boolean a = true;
        for(int i=0; i<s.length(); i++){
            if(s.charAt(i)=='0'){
                a = false;
            } else {
            if(s.charAt(i)=='1' && !a){
                return false;
            }
            }
        }
        return true;
    }
}
