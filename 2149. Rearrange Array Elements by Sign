class Solution {
    public int[] rearrangeArray(int[] nums) {
        int i=0, j=1;
        int[] a = new int[nums.length];
        for(int k : nums){
            if(k>0){
                a[i]=k;
                i+=2;
            } else{
                a[j]=k;
                j+=2;
            }
        }
        return a;
    }
}
