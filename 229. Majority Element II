class Solution {
    public List<Integer> majorityElement(int[] nums) {
        List<Integer> a = new ArrayList<>();
        Map<Integer, Integer> m = new HashMap<>();

        for(int i : nums){
            if(m.containsKey(i)){
                m.put(i, m.get(i)+1);
            } else {
                m.put(i, 1);
            }
        }
        for(int i : m.keySet()){
            if(m.get(i)>nums.length/3) a.add(i);
        }
        return a;
    }
}
