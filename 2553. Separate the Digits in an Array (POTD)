class Solution {
    public int[] separateDigits(int[] nums) {
        ArrayList<Integer> a = new ArrayList<>();
        for(int i=nums.length-1; i>=0; i--){
            int d = nums[i];
            while(d>0){
                a.add(d%10);
                d/=10;
            }
        }

        int[] n = new int[a.size()];
        for(int i=0; i<a.size(); i++){
            n[i] = a.get(a.size()-1-i);
        }

        return n;
    }
}
