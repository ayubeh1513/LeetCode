class Solution {
    public void nextPermutation(int[] nums) {
        int i = nums.length - 2;
        while(i>=0 && nums[i]>=nums[i+1]){
            i--;
        }

        int j = nums.length - 1;
        if(i>=0){
            while(j>=0 && nums[j]<=nums[i]){
                j--;
            }

            swap(nums, i, j);
        }

        reverse(nums, i+1, nums.length-1);
    }

    public void swap(int[] nums, int a, int b){
        int temp = nums[a];
        nums[a] = nums[b];
        nums[b] = temp;
    }

    public void reverse(int[] nums, int s, int e){
        while(s<=e){
            swap(nums, s, e);
            s++;
            e--;
        } 
    }
}
