class Solution {
    public int countSegments(String s) {
        if(s.length()==0) return 0;
        int a = 0;
        int b = 0;
        for(char i : s.toCharArray()){
            if(i!=' ' && b==0){
                a++;
                b=1;
            } else if (i==' ' && b==1){
                b=0;
            } else{
                continue;
            }
        }

        return a;
    }
}
