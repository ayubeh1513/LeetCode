class Solution {
    public String frequencySort(String s) {
        List<Character>[] c = new ArrayList[s.length() + 1];
        Map<Character, Integer> m = new HashMap<>();
        StringBuilder sb = new StringBuilder();

        for(char t : s.toCharArray()){
            if(m.containsKey(t)){
                m.put(t, m.get(t)+1);
            } else {
                m.put(t, 1);
            }
        }

        for(char i : m.keySet()){
            int fr = m.get(i);
            if(c[fr] == null){
                c[fr] = new ArrayList<>();
            }
            c[fr].add(i);
        }

        for(int i=c.length-1; i>0; i--){
            if(c[i]!=null){
                for(char j : c[i]){
                    for(int k=0; k<i; k++){
                        sb.append(j);
                    }
                }
            }
        }

        return sb.toString();
    }
}
