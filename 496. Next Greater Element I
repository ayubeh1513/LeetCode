class Solution {
    public int[] nextGreaterElement(int[] nums1, int[] nums2) {
        HashMap<Integer, Integer> m = new HashMap<>();
        
        for(int i=0; i<nums2.length; i++){
            m.put(nums2[i], i);
        }

        for(int i=0; i<nums1.length; i++){
            int n=m.get(nums1[i]);
            int e=-1;
            for(int j=n+1; j<nums2.length; j++){
                if(nums2[j]>nums1[i]){
                    e=nums2[j];
                    break;
                }
            }
            nums1[i]=e;
        }

        return nums1;
    }
}
