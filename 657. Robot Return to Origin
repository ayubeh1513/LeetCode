class Solution {
    public boolean judgeCircle(String moves) {
        int[] a = new int[4];
        for(char i : moves.toCharArray()){
            if(i=='U') a[0]=a[0]+1;
            if(i=='D') a[1]=a[1]+1;
            if(i=='L') a[2]=a[2]+1;
            if(i=='R') a[3]=a[3]+1;
        }

        if((a[0]-a[1]==0) && (a[2]-a[3]==0)) return true;
        return false;
    }
}
