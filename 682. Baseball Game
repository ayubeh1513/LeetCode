class Solution {
    public int calPoints(String[] o) {
        int[] a = new int[o.length];
        int b = 0;

        for(String i : o){
            if(i.equals("C")){
                b--;
                a[b]=0;
            } else if (i.equals("D")){
                if(b>0){
                    a[b]=a[b-1]*2;
                    b++;
                }
            } else if (i.equals("+")){
                if(b>1){
                    a[b]=a[b-1]+a[b-2];
                    b++;
                }
            } else{
                a[b]=Integer.valueOf(i);
                b++;
            }
        }

        int s = 0;
        for(int i : a){
            s += i;
        }
        return s;
    }
}
