class Solution {
    public void sortColors(int[] nums) {
        int s = 0;
        int m = 0;
        int e = nums.length - 1;

        while(m<=e){
            switch(nums[m]){
                case 0:
                    swap(nums, m, s);
                    m++;
                    s++;
                    break;

                case 1:
                    m++;
                    break;
                
                case 2:
                    swap(nums, m, e);
                    e--;
                    break;
            }
        }
    }

    public static void swap(int[] n, int a, int b){
        int t = n[a];
        n[a] = n[b];
        n[b] = t;
    }
}
