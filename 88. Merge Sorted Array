class Solution {
    public void merge(int[] n1, int m, int[] n2, int n) {
        // if(n==0) return;
        // int i = 0;
        // if(m==0){
        //     for(int u : n2){
        //         n1[i]=u;
        //         i++;
        //         return;
        //     }
        // }

        int i=m+n-1;
        int j=m-1, k=n-1;
        while(k>=0){
            if(j>=0 && n1[j]>n2[k]){
                n1[i]=n1[j];
                j--;
                i--;
            } else{
                n1[i]=n2[k];
                k--;
                i--;
            }
        } 
    }
}
