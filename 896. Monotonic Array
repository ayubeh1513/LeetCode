class Solution {
    public boolean isMonotonic(int[] nums) {
        int a=0;
        if(nums.length==1) return true;
        if(nums[0]>nums[nums.length-1]) a=1;

        for(int i=0; i<nums.length-1; i++){
            if(a==1){
                if(nums[i]<nums[i+1]) return false;
            } else{
                if(nums[i]>nums[i+1]) return false;
            }
        }
        return true;
    }
}
